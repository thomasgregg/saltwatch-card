{
  "name": "saltwatch-card",
  "version": "0.1.4",
  "description": "A detailed Home Assistant tank visualization for estimated water-softener salt level.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && cp dist/saltwatch-card.js dist/saltwatch-card-v0.1.4.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "saltwatch",
    "water-softener"
  ],
  "author": "Thomas Gregg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasgregg/saltwatch-card.git"
  },
  "bugs": {
    "url": "https://github.com/thomasgregg/saltwatch-card/issues"
  },
  "homepage": "https://github.com/thomasgregg/saltwatch-card#readme",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "happy-dom": "^20.12.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
